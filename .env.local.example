# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI
ANTHROPIC_API_KEY="sk-ant-..."

# Cron (Oak delta sync)
# Set this to a random secret string — use the SAME value in Vercel environment variables.
# Vercel cron automatically passes Authorization: Bearer $CRON_SECRET to the cron route.
CRON_SECRET="your-random-secret-here"

# Sentry error monitoring
# Without these, Sentry.init's `enabled` check is false and errors are silently
# NOT reported — the app runs fine but bugs go unseen. Get DSN/org/project from
# sentry.io → Settings → Projects → omnis → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org-id>.ingest.us.sentry.io/<project-id>"
SENTRY_DSN="https://<key>@o<org-id>.ingest.us.sentry.io/<project-id>"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
# Optional — only needed to upload source maps (readable stack traces) on build.
# Create at sentry.io → Settings → Auth Tokens (scopes: project:releases, org:read).
SENTRY_AUTH_TOKEN="sntrys_..."
